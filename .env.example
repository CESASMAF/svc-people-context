PORT=3000
SERVER_HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=people

# Auth — Authentik OIDC (JWT RS256 verification). ADR-027.
# issuer/JWKS sao DERIVADOS de AUTHENTIK_URL + AUTHENTIK_APP_SLUG:
#   issuer = <AUTHENTIK_URL>/application/o/<slug>/
#   jwks   = <AUTHENTIK_URL>/application/o/<slug>/jwks/
# Os overrides abaixo so sao necessarios se o provider OIDC ficar num dominio
# diferente do AUTHENTIK_URL do Management API.
AUTHENTIK_APP_SLUG=people-context
# OIDC_ISSUER=https://auth.acdg-bv.org.br/application/o/people-context/
# JWKS_URL=https://auth.acdg-bv.org.br/application/o/people-context/jwks/
# Opcional — valida o claim `aud` (client_id) do token (hardening).
# OIDC_AUDIENCE=

# Optional — Token introspection RFC 7662 (fallback p/ service accounts).
# Default: <issuer>introspect/. Override apenas se necessario.
# OIDC_INTROSPECT_URL=
# OIDC_INTROSPECT_CLIENT_ID=
# OIDC_INTROSPECT_CLIENT_SECRET=
# ALLOWED_SERVICE_ACCOUNTS=sub1,sub2

# Authentik Management API (provisionamento de users) + base do OIDC acima.
# Token criado via POST /api/v3/core/users/service_account/ ou bootstrap.
# AUTHENTIK_URL=http://localhost:9000
# AUTHENTIK_TOKEN=<bearer token>

# Optional — NATS event publishing (disabled if not set)
NATS_URL=nats://localhost:4222
